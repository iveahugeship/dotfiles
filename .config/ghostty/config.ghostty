# Features
fullscreen = true
link-previews = false
macos-auto-secure-input = false

# Font
font-family = JetBrainsMono Nerd Font Mono
font-size = 15
font-feature = -calt
font-feature = -liga

# Cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

# Window
window-width = 120
window-height = 40
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.98

# Keybinds
keybind = cmd+d=text:\x1bd

keybind = cmd+shift+key_g=new_split:right
keybind = cmd+shift+key_v=new_split:down
keybind = cmd+shift+key_h=goto_split:left
keybind = cmd+shift+key_j=goto_split:down
keybind = cmd+shift+key_k=goto_split:up
keybind = cmd+shift+key_l=goto_split:right
keybind = cmd+shift+key_w=close_surface
keybind = cmd+shift+key_f=toggle_split_zoom
keybind = cmd+shift+key_e=equalize_splits

keybind = cmd+shift+key_r=activate_key_table:resize
keybind = resize/key_h=resize_split:left,40
keybind = resize/key_j=resize_split:down,40
keybind = resize/key_k=resize_split:up,40
keybind = resize/key_l=resize_split:right,40
keybind = resize/escape=deactivate_key_table

keybind = cmd+shift+slash=start_search
keybind = cmd+key_n=navigate_search:next
keybind = cmd+shift+key_n=navigate_search:previous
keybind = cmd+escape=end_search
