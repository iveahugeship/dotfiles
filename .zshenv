# XDG
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Golang
export PATH="$PATH:$HOME/go/bin"

# Krew
export PATH="$PATH:$HOME/.krew/bin"

# rbenv
export PATH=${PATH}:~/.rbenv/shims

# CLI
export EDITOR="vim"
export VISUAL="$EDITOR"
export PAGER="less"
export LESS="-FR"
export MANPAGER="less -R"

# Configs
export STARSHIP_CONFIG="$HOME/.config/starship/config.toml"

export KUBECONFIG=~/.kube/config:~/.kube/config_am1-et-prod:~/.kube/config_ma2-dm-dev:~/.kube/config_ma2-dm-prod:~/.kube/config_ma2-et-prod:~/.kube/config_ma2-test1:~/.kube/config_ma2-test2:~/.kube/config_sjc-et-prod:~/.kube/config_sjc2-et-prod:~/.kube/config_gcp-usw-dm:~/.kube/config_ma2-sre:~/.kube/config_et-la1-prod:~/.kube/config_dm-gcp-use-prod:~/.kube/config_et-ma2-migrate-prod
